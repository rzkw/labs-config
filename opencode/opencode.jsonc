{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "/Users/rizky/ponytail/.opencode/plugins/ponytail.mjs"
  ],
  "permission": "allow",
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:GH_TOKEN}",
        "X-MCP-Readonly": "true",
        "X-MCP-Lockdown": "true",
        "X-MCP-Toolsets": "context,repos,issues,projects,pull_requests,users,git,security_advisories"
      }
    },
    "atlassian-rovo-mcp": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp/authv2",
      "enabled": true,
      "headers": {
