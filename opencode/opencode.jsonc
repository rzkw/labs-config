{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "/Users/rizky/ponytail/.opencode/plugins/ponytail.mjs"
  ],
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" }
  ],
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/",
        "disabled": false,
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:GH_TOKEN}",
          "X-MCP-Readonly": "true",
          "X-MCP-Lockdown": "true",
          "X-MCP-Toolsets": "context,repos,issues,projects,pull_requests,users,git,security_advisories"
        }
      },
      "ansible": {
        "type": "local",
        "command": ["npx", "-y", "@ansible/ansible-mcp-server", "--stdio"],
        "disabled": false,
        "environment": {
          "WORKSPACE_ROOT": "."
        }
      }
    }
  }
}
